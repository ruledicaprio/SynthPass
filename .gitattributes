# Shell scripts must keep LF endings even when checked out on Windows — a CRLF shebang line
# makes them unrunnable inside the Linux builder container ("bad interpreter: /usr/bin/env\r").
*.sh text eol=lf
*.ttf binary
# Preserve upstream licence bytes, including their original line endings.
# Upstream licences retain their intentional spaces, blank EOF and CRLF bytes.
# All other files keep the normal whitespace checks.
crates/synthpass-gen/fonts/OFL-liberation.txt -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
crates/synthpass-gen/fonts/OFL-source-sans-3.txt -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol

# The outcome ledger is pinned by sha256 inside the real-specimen baseline
# (outcomes_sha256, checked by scripts/check-headline-numbers.sh). A CRLF checkout on
# Windows changes the bytes and fails that check, so the ledger keeps LF everywhere.
knowledge/benchmarks/real-specimen-outcomes.jsonl text eol=lf

# The probe summary is committed as evidence: ADR-0014 quotes figures from it, so a reader
# should be able to compare two checkouts and get the same bytes. Nothing pins its sha256
# today -- this is so that a Windows and a Linux checkout never disagree if something ever does.
knowledge/benchmarks/mrz-matrix-probe-2026-09-18.json text eol=lf

# bench_report_golden compares these fixtures byte-for-byte against generated output, and
# pulls them in with include_str!, which embeds working-tree bytes at compile time. Under
# core.autocrlf they materialise with CRLF on Windows while the generated side uses LF, so
# 2 of 11 tests fail there on a clean checkout of main and pass in Linux CI -- which is why
# it went unnoticed. Same class of file, and same reason, as the two pins above.
crates/synthpass-bench/tests/fixtures/bench_report/** text eol=lf
# mrz_wire_golden compares MrzData's JSON with this file byte-for-byte; same reason.
crates/synthpass-bench/tests/fixtures/mrz_wire_golden.jsonl text eol=lf
# synthpass-layout's builtins test compares layouts/*.json byte-for-byte with the emitter's
# output, which ends lines with LF; under core.autocrlf the checkout would have CRLF. Same
# class of file, and same reason, as the pins above.
crates/synthpass-layout/layouts/*.json text eol=lf
# Font snapshot/golden tests embed these bytes and compare LF-joined rows.
crates/synthpass-gen/tests/fixtures/golden_viz_liberation_mono.tsv text eol=lf
crates/synthpass-gen/tests/fixtures/viz_field_scales.tsv text eol=lf
